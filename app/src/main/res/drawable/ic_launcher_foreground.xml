<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca do Eat Control: um visor de leitura com uma decisão dentro.

    A escolha é deliberada. Um prato ou um talher diria "comida" — que é o que todo app de nutrição
    já diz. O visor mais a marca de verificação dizem o que o produto realmente faz: olhar e
    responder. E as duas formas são geométricas, então continuam legíveis a 48dp.

    Tudo fica dentro da zona segura de 72dp (raio 36 a partir do centro 54,54), porque o launcher
    recorta os 108dp em máscaras que variam por fabricante.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cantos do visor -->
    <path
        android:pathData="M31,43 L31,35 Q31,31 35,31 L43,31"
        android:strokeColor="#42E0AB"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M65,31 L73,31 Q77,31 77,35 L77,43"
        android:strokeColor="#42E0AB"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M77,65 L77,73 Q77,77 73,77 L65,77"
        android:strokeColor="#42E0AB"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M43,77 L35,77 Q31,77 31,73 L31,65"
        android:strokeColor="#42E0AB"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- A decisão -->
    <path
        android:pathData="M42,55 L50,63 L67,44"
        android:strokeColor="#F7F9FC"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
