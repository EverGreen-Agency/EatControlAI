<?xml version="1.0" encoding="utf-8"?>
<!--
    Cores de sistema. A paleta do produto vive em `ui/theme/Color.kt`, em Compose.

    Aqui só entra o que o Android precisa antes de a primeira composição existir: o fundo da janela
    e as barras. Manter os dois em sincronia com `EcColors.Background` é o que evita o flash de
    tela clara no cold start.
-->
<resources>
    <color name="ec_background">#050814</color>
    <color name="ec_surface">#0B1225</color>
</resources>
