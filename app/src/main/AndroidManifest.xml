<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissões declaradas conforme as trilhas do MVP avançam.
        Checkpoint de privacidade do edital: nada é pedido "por precaução" — cada permissão
        corresponde a uma capacidade descrita em docs/SRS.md.
    -->

    <!-- FR-002: câmera do celular como fonte alternativa de frame (trilha CameraX). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- FR-003: captura de voz para STT. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- FR-006: consulta a base de produtos por código de barras. Fora do caminho crítico (ADR-0002). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FR-001: comunicação com os óculos pelo Meta DAT (ADR-0006). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Feedback tátil (haptic feedback) ao detectar código de barras ou alimentos. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".EatControlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EatControlAI"
        tools:targetApi="34">
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EatControlAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Retorno do app Meta AI após o fluxo de autorização do DAT.
                É assim que o controle volta para cá quando o usuário conclui o pareamento:
                Wearables.startRegistration(activity) abre o Meta AI, e o Meta AI devolve por
                deep link neste esquema. Ver docs/adr/0006-dat-version.md.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="eatcontrolai" />
            </intent-filter>
        </activity>
    </application>

</manifest>
